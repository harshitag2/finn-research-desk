# No key is needed to browse, ingest PDFs, or retrieve cited evidence.
# Gemini is selected by default. Keep the actual key in an ignored .env or a hosted secret.
FINN_PROVIDER=gemini
FINN_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# Alternative adapters remain available: compatible or ollama.
FINN_API_URL=
FINN_API_KEY=
# Compatible example: your provider's full /chat/completions URL.
# Gemini uses the official generateContent endpoint automatically.
# Ollama example: http://127.0.0.1:11434/api/chat (local dev only).
PORT=4173
